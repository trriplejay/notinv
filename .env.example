# Copy to .env for local development; existing environment values take precedence.
# Use -env-file to select another file. Missing default .env files are optional.
NOTINV_LISTEN=:8080
DATABASE_URL=file:./data/notinv.db
NOTINV_RETENTION_DAYS=30
NOTINV_LOG_LEVEL=info
NOTINV_LOG_FORMAT=text

# Required only for libsql: database URLs. Never commit real credentials.
DATABASE_AUTH_TOKEN=

# Leave both empty to run notifications in dry-run mode.
NOTINV_DISCORD_TOKEN=
NOTINV_DISCORD_USER_ID=

# Per-script variables follow SCRIPTNAME_VAR, e.g. WIDGET_STOCK_URL.
# Scripts read their own variables directly with os.Getenv.
